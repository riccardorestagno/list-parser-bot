# Copy to server/.env and fill in what you need. See "Environment variables" in the README
# for defaults. Every setting is optional but sign-in, and the Reddit account to sweep with:
# without a key or the line turning sign-in off, the API refuses every request.

# The account the bot posts as: a "script" app at https://www.reddit.com/prefs/apps
LISTBOT_REDDIT_CLIENT_ID=
LISTBOT_REDDIT_CLIENT_SECRET=
LISTBOT_REDDIT_USER_AGENT=
LISTBOT_REDDIT_USERNAME=autobuzzfeedbot
LISTBOT_REDDIT_PASSWORD=

# Sweeping on a schedule posts to Reddit, so it's off on your own computer unless turned on
# LISTBOT_SCHEDULE_ENABLED=true
# LISTBOT_SWEEP_MINUTES=90

# LISTBOT_DATA_DIR=C:/path/to/data
# LISTBOT_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# LISTBOT_API_DOCS=false

# Sign-in is checked with the tools dashboard's public key. On your own computer, turn it off:
LISTBOT_AUTH_DISABLED=true
# Or check real tokens: the key from the dashboard API's /auth/public-key, line breaks as \n
# LISTBOT_AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----
